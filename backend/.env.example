# String de conexão Postgres. Exemplo (Neon/Supabase/Railway):
# postgresql://usuario:senha@host:5432/nomedobanco?sslmode=require
DATABASE_URL="postgresql://usuario:senha@host:5432/chatapp?sslmode=require"

JWT_SECRET="troque-este-valor-por-uma-string-aleatoria-longa"
JWT_EXPIRES_IN="7d"
PORT=4000

# Em produção, coloque a URL exata do frontend publicado (sem barra no final).
# Ex: "https://seuapp.vercel.app"
CORS_ORIGIN="http://localhost:5173"

# STUN publico (gratis, funciona na maioria das redes)
STUN_URLS="stun:stun.l.google.com:19302"

# TURN (necessário em produção para redes com NAT restritivo/CGNAT/4G).
# Veja o README, seção "Configurando STUN/TURN", para provedores gratuitos.
TURN_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""
